  });
});

app.get("/api/oportunidades", async (req, res) => {
  try {
    const dados = await atualizarCache(
      req.query.atualizar === "1"
    );

    const termo = normalizar(req.query.q || "");
    const categoria = normalizar(
      req.query.categoria || "todos"
    );
    const instituicao = normalizar(
      req.query.instituicao || "todas"
    );

    const oportunidades = dados.oportunidades.filter(item => {
      const texto = normalizar([
        item.titulo,
        item.instituicao,
        item.categoria,
        item.tipo,
        item.descricao,
        item.detalhes,
        item.requisitos,
        item.modalidade
      ].filter(Boolean).join(" "));

      return (
        (!termo || texto.includes(termo)) &&
        (
          categoria === "todos" ||
          normalizar(item.categoria) === categoria
        ) &&
        (
          instituicao === "todas" ||
          normalizar(item.instituicao) === instituicao
        )
      );
    });

    res.json({
      atualizadoEm: dados.atualizadoEm,
      total: oportunidades.length,
      oportunidades,
      fontes: dados.fontes,
      aviso:
        "As informações extraídas automaticamente podem estar incompletas. Confirme inscrições, requisitos, valores e prazos no portal oficial. Um link encontrado não comprova que existam vagas abertas."
    });
  } catch (erro) {
    res.status(500).json({
      erro: "Não foi possível consultar as oportunidades.",
      detalhe:
        process.env.NODE_ENV === "development"
          ? erro.message
          : undefined
    });
  }
});

